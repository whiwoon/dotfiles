# Managed by chezmoi. Keep this minimal: it runs for every zsh invocation.

# User-local zsh extracted from Debian packages on wing needs explicit module/function paths
# because the binary was not installed under /usr.
if [[ -d "$HOME/.local/opt/zsh-deb/usr/lib/aarch64-linux-gnu/zsh/5.9" ]]; then
  module_path=("$HOME/.local/opt/zsh-deb/usr/lib/aarch64-linux-gnu/zsh/5.9" $module_path)
fi
if [[ -d "$HOME/.local/opt/zsh-deb/usr/share/zsh/functions" ]]; then
  fpath=("$HOME/.local/opt/zsh-deb/usr/share/zsh/functions" "$HOME/.local/opt/zsh-deb/usr/share/zsh/functions"/*(/) $fpath)
fi
