# Managed by chezmoi. Edit with: chezmoi edit ~/.zshrc

# Keep user-local binaries first. This also preserves the previous wing ~/.zshrc
# behavior, which sourced ~/.local/bin/env when present.
if [[ -f "$HOME/.local/bin/env" ]]; then
  source "$HOME/.local/bin/env"
fi
path=("$HOME/.local/bin" $path)
export PATH

# History
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

# System zsh is installed on wing. Do not prepend the old user-local zsh
# extraction paths here; keeping the distro function/module trees first avoids
# mixing packaged and manually extracted zsh components.

# Completion
autoload -Uz compinit
if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
  zcompdump="$XDG_CACHE_HOME/zsh/zcompdump"
else
  zcompdump="$HOME/.cache/zsh/zcompdump"
fi
mkdir -p "${zcompdump:h}"
compinit -d "$zcompdump"

# Sensible shell behavior
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# Directory listing aliases. Keep plain `ls` close to GNU ls semantics, and use
# eza for human-facing convenience aliases when it is installed on the host.
if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b)"
fi
if ls --color=auto -d . >/dev/null 2>&1; then
  alias ls='ls --color=auto'
fi
if command -v eza >/dev/null 2>&1; then
  alias ll='eza -la --icons=auto --git --group-directories-first'
  alias la='eza -a --icons=auto --group-directories-first'
  alias l='eza --icons=auto --group-directories-first'
  alias tree='eza --tree --icons=auto --group-directories-first'
else
  alias ll='ls -alF --color=auto'
  alias la='ls -A --color=auto'
  alias l='ls -CF --color=auto'
fi

# fzf integration. The fzf binary is installed by the host package manager;
# chezmoi only manages shell behavior and keeps it conditional for portability.
if command -v fzf >/dev/null 2>&1; then
  if [[ -z "${FZF_DEFAULT_OPTS:-}" ]]; then
    export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline --cycle"
  fi
  if [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
    source /usr/share/doc/fzf/examples/key-bindings.zsh 2>/dev/null
  elif [[ -r "$HOME/.local/opt/fzf/shell/key-bindings.zsh" ]]; then
    source "$HOME/.local/opt/fzf/shell/key-bindings.zsh" 2>/dev/null
  fi
  if [[ -r /usr/share/doc/fzf/examples/completion.zsh ]]; then
    source /usr/share/doc/fzf/examples/completion.zsh 2>/dev/null
  elif [[ -r "$HOME/.local/opt/fzf/shell/completion.zsh" ]]; then
    source "$HOME/.local/opt/fzf/shell/completion.zsh" 2>/dev/null
  fi
fi

# Antidote plugin manager
ANTIDOTE_HOME="${ANTIDOTE_HOME:-$HOME/.local/share/antidote}"
ZSH_PLUGINS="${ZSH_PLUGINS:-$HOME/.config/antidote/zsh_plugins.txt}"
if [[ -r "$ANTIDOTE_HOME/antidote.zsh" && -r "$ZSH_PLUGINS" ]]; then
  source "$ANTIDOTE_HOME/antidote.zsh"
  antidote load "$ZSH_PLUGINS"
fi

# Search history by the text already typed at the prompt. This is broader than
# prefix-only search: typing `co` can find `docker compose ...` as well as
# `git commit ...`. Bind both terminfo and common ANSI arrow-key sequences for
# portability across terminals.
if (( $+functions[history-substring-search-up] && $+functions[history-substring-search-down] )); then
  [[ -n "${terminfo[kcuu1]:-}" ]] && bindkey "${terminfo[kcuu1]}" history-substring-search-up
  [[ -n "${terminfo[kcud1]:-}" ]] && bindkey "${terminfo[kcud1]}" history-substring-search-down
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Local, non-versioned machine overrides.
if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
